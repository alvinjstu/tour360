{
  "name": "panorama-360-tour",
  "version": "0.0.1",
  "description": "这是一个免费的实景全景漫游桌面客户端，可以安装在window/mac系统上",
  "scripts": {
    "start": "npm run dev",
    "dev": "dumi dev",
    "build": "dumi build",
    "preview": "dumi preview",
    "prepare": "husky install && dumi setup",
    "deploy": "gh-pages -d dist",
    "predeploy": "npm run build"
  },
  "authors": [
    "alvin"
  ],
  "license": "MIT",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{md,json}": [
      "prettier --write --no-error-on-unmatched-pattern"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "dumi": "^2.4.13",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3",
    "prettier": "^2.7.1",
    "gh-pages": "^6.1.0"
  }
}
